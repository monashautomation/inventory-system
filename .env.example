DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb?schema=public
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_AUTH_TOKEN=
MCP_ENDPOINT=

KIOSK_SECRET=
VITE_KIOSK_SECRET=

# Label Printer
PRINTER_URL=http://localhost:6767/printer

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gcode-vault
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password123

# Metrics
METRICS_ENABLED=false
METRICS_USERNAME=
METRICS_PASSWORD=
METRICS_PRUSA_ENABLED=true
METRICS_BAMBU_ENABLED=true
# legacy: existing mapped bambulab_* metrics from /status polling
# prometheus: pass through Bambuddy native metrics from /api/v1/metrics
# prefer prometheus and fall back to legacy if it fails
METRICS_BAMBU_SOURCE=prometheus

# Tamarin SDK (Notion + Discord) — all vars required to enable these routes
NOTION_TOKEN=
MEMBERS_DB_ID=
PROJECTS_DB_ID=
TAMARIN_API_BEARER_TOKEN=
AFTER_HOURS_DISCORD_WEBHOOK=
AFTER_HOURS_GUILD_ID=
AFTER_HOURS_BOT_TOKEN=
# One short line per failed print, posted to the #print-failures channel.
# Inert when unset.
PRINT_FAILURES_DISCORD_WEBHOOK=
